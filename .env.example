# Copy to .env and fill in. Every variable is optional except a model key for real (non-offline) output.

# --- model provider: auto | anthropic | openai | ollama | offline -------------------------
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY+OPENAI_MODEL, else offline
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI or any OpenAI-compatible server (vLLM, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_FAST_MODEL=
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens   # for models that require it

# Local model via Ollama (docker compose --profile local-llm up -d ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

LLM_TEMPERATURE=0.2
LLM_CACHE=true

# --- tools ---------------------------------------------------------------------------------
SEARCH_PROVIDER=mock          # mock | tavily | none
TAVILY_API_KEY=
KB_PATH=data/knowledge_base.json
MOCK_WEB_PATH=data/mock_web_index.json
MOCK_SEARCH_FAILURE_RATE=0    # e.g. 0.5 to demo retries and graceful degradation
MOCK_SEARCH_LATENCY_MS=0

# --- behaviour -----------------------------------------------------------------------------
SUMMARY_LENGTH_MODE=spec      # spec (200-300 words) | adaptive (shorter floor for very short episodes)
MAX_CLAIMS=8
MAX_STEPS_PER_CLAIM=4
MAP_REDUCE_THRESHOLD_WORDS=15000
AGENT_TODAY=                  # pin "today" for reproducible fact-checks, e.g. 2026-10-13

# --- worker --------------------------------------------------------------------------------
QUEUE_URI=dir://queue         # or https://sqs.<region>.amazonaws.com/<account>/<queue>
OUTPUT_URI=output/jobs        # or s3://bucket/prefix
WORKER_MAX_ATTEMPTS=3
