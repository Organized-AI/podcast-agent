# Copy to .env and fill in. Every variable is optional except a model key for real (non-offline) output.

# --- model provider: auto | anthropic | bedrock | openai | ollama | offline -------------------------
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY+OPENAI_MODEL, else offline
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace: Console → Settings → Workspaces → ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Claude effort: low | medium | high | xhigh | max ("none" for models without effort)
ANTHROPIC_EFFORT=low
# Log Claude's thinking summaries as "thinking" events in the trace
ANTHROPIC_THINKING_SUMMARIES=true

# Claude on Amazon Bedrock (LLM_PROVIDER=bedrock). Credentials come from the AWS chain:
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE with ~/.aws mounted, or an IAM role.
BEDROCK_MODEL=
BEDROCK_FAST_MODEL=
AWS_REGION=us-east-1
PROMPT_CACHE=true

# OpenAI or any OpenAI-compatible server (vLLM, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_FAST_MODEL=
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens   # for models that require it

# Local model via Ollama (docker compose --profile local-llm up -d ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Sampling temperature for OpenAI-compatible and Ollama models (Claude 5.5 models take none)
LLM_TEMPERATURE=0.2
# Local response cache for model calls (skip repeat calls during development)
LLM_CACHE=true
# Where it lives. Leave this unset: the default is .cache/llm locally and /cache/llm in the Docker image, whose
# working directory isn't writable by the container's user.
# LLM_CACHE_DIR=.cache/llm

# --- tools ---------------------------------------------------------------------------------
# mock | tavily | none
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
KB_PATH=data/knowledge_base.json
MOCK_WEB_PATH=data/mock_web_index.json
# e.g. 0.5 to demo retries and graceful degradation
MOCK_SEARCH_FAILURE_RATE=0
MOCK_SEARCH_LATENCY_MS=0

# --- behaviour -----------------------------------------------------------------------------
# spec (200-300 words) | adaptive (shorter floor for very short episodes)
SUMMARY_LENGTH_MODE=spec
MAX_CLAIMS=8
MAX_STEPS_PER_CLAIM=4
MAP_REDUCE_THRESHOLD_WORDS=15000
# pin "today" for reproducible fact-checks, e.g. 2026-10-13
AGENT_TODAY=

# --- cost ----------------------------------------------------------------------------------
# Per-episode budget in USD at list prices; "off" for none. An episode over it raises PodcastAgentCostBudgetExceeded.
COST_BUDGET_USD=0.20
# warn (record the overrun, finish the episode) | enforce (stop verifying claims once the budget is spent)
COST_BUDGET_MODE=warn

# --- worker --------------------------------------------------------------------------------
# or https://sqs.<region>.amazonaws.com/<account>/<queue>
QUEUE_URI=dir://queue
# or s3://bucket/prefix
OUTPUT_URI=output/jobs
WORKER_MAX_ATTEMPTS=3

# --- telemetry (OpenTelemetry) -------------------------------------------------------------
# Off unless an endpoint or exporter is set. Standard OTEL_* variables; see docs/OBSERVABILITY.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Adds prompts, completions and tool queries to spans. Keep off outside debugging.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
